let vec = import('std/vec');
let package = import('std/package');

let configure = fn(info) {
    let pkg = package.new(
        'HTTP',
        desc = 'A simple HTTP interface for GET/PUT/POST requests. Uses cURL internally.',
        version = '0.2.0',
        feral = '>=2.7.0',
        author = vec.new('Chirag-Khandelwal <github@mail.chiragkh.me>')
    );

    pkg.requires('Curl', version = '~0.2.1', feral = true);

    return feral.ok(pkg);
};

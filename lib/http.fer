# Importable file for the package HTTP generated by Feral package manager
let map = import('std/map');

let curl = import('curl/curl');

let multi = curl.newMulti();

let Response = struct(
    code = 0,
    body = '',
    easy = nil,
    timeout = -1,
    delim = '\n'
);
Response.setTypeName('Response');

let str in Response = fn() {
    let s = 'Response{code: ';
    s += code.str();
    s += ', body:';
    s += body;
    s += '}';
    return s;
};

####################################################################################################
############################################### API ################################################
####################################################################################################

"
  fn(.kw, url) -> Result(Response)
Performs an HTTP GET request on `url`.
Returns the Result.ok(Response), on success, or Result.err(code, msg) on failure.
Takes the following optional keyword arguments:
* `headers = Map<string,string>` - A map of headers to be used for the request. (default: empty map)
* `stream = true/false` - If `true`, the request is in a streaming mode, so response can be iterated for more content as it comes. (default: false)
* `timeout = <int>` - The duration before a streaming response times out if no data is received. If `-1`, timeout is infinite. (default: -1)
"
let get = fn(.kw, url) {
    let headers = ref(kw['headers']) ?? map.new();
    let stream = kw['stream'] ?? false;
    let timeout = kw['timeout'] ?? -1;
    let c = curl.newEasy();
    let resp = Response(0, '', ref(c), timeout);
    c.setOpt(curl.OPT_URL, url);
    c.setOpt(curl.OPT_FOLLOWLOCATION, 1);
    c.setOpt(curl.OPT_NOPROGRESS, 1);
    if !headers.empty() {
        c.setOpt(curl.OPT_HTTPHEADER, headers);
    }
    c.setOpt(curl.OPT_WRITEFUNCTION, resp.body.append);
    if !stream {
        let res = c.perform();
        if res != curl.E_OK {
            return feral.err(res, 'failed to perform GET using curl: ', curl.easyStrErr(res));
        }
        resp.code = c.getInfo(curl.INFO_RESPONSE_CODE);
        return feral.ok(resp);
    }
    multi.addEasy(c);
    return feral.ok(resp);
};

"
  fn(.kw, url, data) -> Result(Response)
Performs an HTTP POST request on `url`, using `data` string.
Returns the Result.ok(Response), on success, or Result.err(code, msg) on failure.
Takes the following optional keyword arguments:
* `headers = Map<string,string>` - A map of headers to be used for the request. (default: empty map)
                                   Here, headers must contain a `content-type` field. If it doesn't exist, one is added with value `application/x-www-form-urlencoded`.
"
let post = fn(.kw, url, data) {
    let headers = ref(kw['headers']) ?? map.new();
    if !headers.find('content-type') && !headers.find('Content-Type') {
        headers.insert('content-type', 'application/x-www-form-urlencoded');
    }
    let body = '';
    let c = curl.newEasy();
    c.setOpt(curl.OPT_URL, url);
    c.setOpt(curl.OPT_FOLLOWLOCATION, 1);
    c.setOpt(curl.OPT_NOPROGRESS, 1);
    c.setOpt(curl.OPT_HTTPHEADER, headers);
    c.setOpt(curl.OPT_WRITEFUNCTION, body.append);
    c.setOpt(curl.OPT_POSTFIELDS, data);
    let res = c.perform();
    if res != curl.E_OK {
        return feral.err(res, 'failed to perform POST using curl: ', curl.easyStrErr(res));
    }
    let code = c.getInfo(curl.INFO_RESPONSE_CODE);
    return feral.ok(Response(ref(code), ref(body)));
};

####################################################################################################
######################################### Response Logic ###########################################
####################################################################################################

# Used to read through incoming data, delimited by Response.delim, when stream mode is enabled.
let next in Response = fn() {
    if !self.easy.done() {
        let end = self.timeout < 0 ? self.timeout : (time.resolve(time.now(), time.milli) + self.timeout);
        while (end < 0 || time.resolve(time.now(), time.milli) < end) && !self.easy.done() {
            let res = multi.perform();
            if res != curl.M_OK {
                raise('failed to fetch data through curl: ', curl.multiStrErr(res));
            }
            if self.body.empty() { continue; }
            let delimPos = self.body.find(self.delim);
            if delimPos < 0 { continue; }
            let data = self.body.sub(0, delimPos);
            self.body = self.body.sub(delimPos + 1);
            return data;
        }
    }
    if !self.body.empty() {
        let data = self.body;
        self.body.clear();
        return data;
    }
    return nil;
};

let setDelim in Response = fn(delim) { self.delim = delim; };